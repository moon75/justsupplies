# Copy to .env.production and fill in.
# Password for the control panel at /admin
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string used to sign the login cookie (e.g. output of: openssl rand -hex 32)
ADMIN_SECRET=
# Only set to 1 if you open the site over plain http (no SSL yet), otherwise login won't stick
ADMIN_INSECURE_COOKIE=
